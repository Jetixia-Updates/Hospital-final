import {
  Search,
  Plus,
  Filter,
  Download,
  FileText,
  Pill,
  Beaker,
  Heart,
  Activity,
  TrendingUp,
  AlertCircle,
  Eye,
  Edit,
  MoreVertical,
  Calendar,
  User,
} from "lucide-react";
import { useState } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";

const RecordCard = ({
  type,
  title,
  date,
  doctor,
  status,
  icon: Icon,
}: {
  type: string;
  title: string;
  date: string;
  doctor: string;
  status: "active" | "archived" | "pending";
  icon: React.ReactNode;
}) => {
  const statusConfig = {
    active: { bg: "bg-blue-50", badge: "Active", color: "text-blue-700" },
    archived: { bg: "bg-slate-50", badge: "Archived", color: "text-slate-700" },
    pending: { bg: "bg-yellow-50", badge: "Pending", color: "text-yellow-700" },
  };

  const config = statusConfig[status];

  return (
    <div className={`${config.bg} rounded-lg border border-slate-200 p-6 hover:shadow-md transition-shadow`}>
      <div className="flex items-start justify-between mb-4">
        <div className="w-12 h-12 bg-white rounded-lg flex items-center justify-center">
          {Icon}
        </div>
        <span className={`text-xs font-semibold px-3 py-1 rounded-full bg-white border ${config.color} border-current`}>
          {config.badge}
        </span>
      </div>

      <p className="text-xs text-slate-500 uppercase tracking-wide mb-1">{type}</p>
      <h3 className="text-lg font-semibold text-slate-900 mb-4">{title}</h3>

      <div className="space-y-2 text-sm text-slate-600 mb-4">
        <div className="flex items-center justify-between">
          <span>Doctor:</span>
          <span className="font-medium text-slate-900">{doctor}</span>
        </div>
        <div className="flex items-center justify-between">
          <span>Date:</span>
          <span className="font-medium text-slate-900">{date}</span>
        </div>
      </div>

      <button className="w-full bg-white hover:bg-slate-50 text-slate-900 border border-slate-200 font-medium py-2 rounded-lg transition-colors flex items-center justify-center gap-2">
        <Eye className="w-4 h-4" />
        View Record
      </button>
    </div>
  );
};

const PrescriptionItem = ({
  medication,
  dosage,
  frequency,
  duration,
  prescribed,
}: {
  medication: string;
  dosage: string;
  frequency: string;
  duration: string;
  prescribed: string;
}) => (
  <div className="border-b border-slate-200 py-4 last:border-b-0">
    <div className="flex items-start justify-between mb-2">
      <h4 className="font-semibold text-slate-900">{medication}</h4>
      <span className="text-xs text-slate-500">{prescribed}</span>
    </div>
    <div className="grid grid-cols-3 gap-4 text-sm">
      <div>
        <p className="text-slate-600">Dosage</p>
        <p className="font-medium text-slate-900">{dosage}</p>
      </div>
      <div>
        <p className="text-slate-600">Frequency</p>
        <p className="font-medium text-slate-900">{frequency}</p>
      </div>
      <div>
        <p className="text-slate-600">Duration</p>
        <p className="font-medium text-slate-900">{duration}</p>
      </div>
    </div>
  </div>
);

const LabTestResult = ({
  test,
  result,
  reference,
  status,
  date,
}: {
  test: string;
  result: string;
  reference: string;
  status: "normal" | "abnormal" | "pending";
  date: string;
}) => {
  const statusConfig = {
    normal: { color: "text-green-700", bg: "bg-green-50" },
    abnormal: { color: "text-red-700", bg: "bg-red-50" },
    pending: { color: "text-yellow-700", bg: "bg-yellow-50" },
  };

  const config = statusConfig[status];

  return (
    <div className="border border-slate-200 rounded-lg p-4">
      <div className="flex items-start justify-between mb-3">
        <h4 className="font-semibold text-slate-900">{test}</h4>
        <span
          className={`text-xs font-semibold px-2 py-1 rounded ${config.bg} ${config.color}`}
        >
          {status.charAt(0).toUpperCase() + status.slice(1)}
        </span>
      </div>
      <div className="grid grid-cols-3 gap-4 text-sm">
        <div>
          <p className="text-slate-600">Result</p>
          <p className="font-medium text-slate-900">{result}</p>
        </div>
        <div>
          <p className="text-slate-600">Reference</p>
          <p className="font-medium text-slate-900">{reference}</p>
        </div>
        <div>
          <p className="text-slate-600">Date</p>
          <p className="font-medium text-slate-900">{date}</p>
        </div>
      </div>
    </div>
  );
};

export default function MedicalRecords() {
  const [searchTerm, setSearchTerm] = useState("");
  const [activeTab, setActiveTab] = useState("overview");

  const records = [
    {
      type: "Consultation",
      title: "Cardiac Checkup",
      date: "2024-01-15",
      doctor: "Dr. Hassan Al-Rashid",
      status: "active" as const,
      icon: <Heart className="w-6 h-6 text-red-600" />,
    },
    {
      type: "Lab Test",
      title: "Blood Work Results",
      date: "2024-01-10",
      doctor: "Dr. Fatima Al-Dosari",
      status: "active" as const,
      icon: <Beaker className="w-6 h-6 text-purple-600" />,
    },
    {
      type: "Prescription",
      title: "Medication Refill",
      date: "2024-01-08",
      doctor: "Dr. Mohammed Al-Harbi",
      status: "active" as const,
      icon: <Pill className="w-6 h-6 text-blue-600" />,
    },
    {
      type: "Surgery Report",
      title: "Post-Operative Assessment",
      date: "2023-12-20",
      doctor: "Dr. Noor Al-Otaibi",
      status: "archived" as const,
      icon: <FileText className="w-6 h-6 text-orange-600" />,
    },
  ];

  const prescriptions = [
    {
      medication: "Lisinopril",
      dosage: "10 mg",
      frequency: "Once daily",
      duration: "30 days",
      prescribed: "Jan 15, 2024",
    },
    {
      medication: "Metformin",
      dosage: "500 mg",
      frequency: "Twice daily",
      duration: "90 days",
      prescribed: "Jan 10, 2024",
    },
    {
      medication: "Aspirin",
      dosage: "81 mg",
      frequency: "Once daily",
      duration: "Ongoing",
      prescribed: "Dec 20, 2023",
    },
  ];

  const labTests = [
    {
      test: "Blood Glucose",
      result: "125 mg/dL",
      reference: "70-100 mg/dL",
      status: "abnormal" as const,
      date: "Jan 10, 2024",
    },
    {
      test: "Total Cholesterol",
      result: "185 mg/dL",
      reference: "<200 mg/dL",
      status: "normal" as const,
      date: "Jan 10, 2024",
    },
    {
      test: "HDL Cholesterol",
      result: "52 mg/dL",
      reference: ">40 mg/dL",
      status: "normal" as const,
      date: "Jan 10, 2024",
    },
    {
      test: "LDL Cholesterol",
      result: "115 mg/dL",
      reference: "<100 mg/dL",
      status: "abnormal" as const,
      date: "Jan 10, 2024",
    },
  ];

  const vitalSigns = [
    { label: "Blood Pressure", value: "135/88 mmHg", status: "Elevated" },
    { label: "Heart Rate", value: "72 bpm", status: "Normal" },
    { label: "Temperature", value: "36.5°C", status: "Normal" },
    { label: "Respiratory Rate", value: "16 breaths/min", status: "Normal" },
    { label: "BMI", value: "27.5 kg/m²", status: "Overweight" },
    { label: "Oxygen Saturation", value: "98%", status: "Normal" },
  ];

  return (
    <Layout>
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        {/* Header */}
        <div className="mb-8">
          <h1 className="text-4xl font-bold text-slate-900 mb-2">Medical Records</h1>
          <p className="text-lg text-slate-600">
            Patient medical history, prescriptions, lab results, and vital signs
          </p>
        </div>

        {/* Patient Info Card */}
        <div className="bg-white rounded-lg border border-slate-200 p-6 mb-8">
          <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div>
              <p className="text-sm text-slate-600 mb-1">Patient Name</p>
              <p className="text-lg font-semibold text-slate-900">Ahmed Mohammed</p>
            </div>
            <div>
              <p className="text-sm text-slate-600 mb-1">Patient ID</p>
              <p className="text-lg font-semibold text-slate-900">P001</p>
            </div>
            <div>
              <p className="text-sm text-slate-600 mb-1">Age</p>
              <p className="text-lg font-semibold text-slate-900">45 years</p>
            </div>
            <div>
              <p className="text-sm text-slate-600 mb-1">Last Visit</p>
              <p className="text-lg font-semibold text-slate-900">Jan 15, 2024</p>
            </div>
          </div>
        </div>

        {/* Search and Filter */}
        <div className="bg-white rounded-lg border border-slate-200 p-6 mb-8">
          <div className="flex flex-col md:flex-row gap-4">
            <div className="flex-1 relative">
              <Search className="absolute left-3 top-3 w-5 h-5 text-slate-400" />
              <input
                type="text"
                placeholder="Search records..."
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                className="w-full pl-10 pr-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
            </div>
            <button className="flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-900 px-4 py-2 rounded-lg font-medium transition-colors">
              <Filter className="w-5 h-5" />
              Filter
            </button>
            <button className="flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">
              <Download className="w-5 h-5" />
              Export
            </button>
          </div>
        </div>

        {/* Tabs */}
        <div className="flex gap-4 mb-8 border-b border-slate-200">
          {[
            { id: "overview", label: "Overview" },
            { id: "prescriptions", label: "Prescriptions" },
            { id: "lab-tests", label: "Lab Tests" },
            { id: "vital-signs", label: "Vital Signs" },
          ].map((tab) => (
            <button
              key={tab.id}
              onClick={() => setActiveTab(tab.id)}
              className={`px-4 py-4 font-medium border-b-2 transition-colors ${
                activeTab === tab.id
                  ? "border-blue-600 text-blue-600"
                  : "border-transparent text-slate-600 hover:text-slate-900"
              }`}
            >
              {tab.label}
            </button>
          ))}
        </div>

        {/* Tab Content */}
        <div>
          {activeTab === "overview" && (
            <div>
              <h2 className="text-2xl font-bold text-slate-900 mb-6">Recent Records</h2>
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
                {records.map((record, index) => (
                  <RecordCard key={index} {...record} />
                ))}
              </div>
            </div>
          )}

          {activeTab === "prescriptions" && (
            <div>
              <h2 className="text-2xl font-bold text-slate-900 mb-6">
                Active Prescriptions
              </h2>
              <div className="bg-white rounded-lg border border-slate-200 p-6">
                {prescriptions.map((prescription, index) => (
                  <PrescriptionItem key={index} {...prescription} />
                ))}
              </div>
            </div>
          )}

          {activeTab === "lab-tests" && (
            <div>
              <h2 className="text-2xl font-bold text-slate-900 mb-6">Lab Test Results</h2>
              <div className="grid grid-cols-1 gap-4">
                {labTests.map((test, index) => (
                  <LabTestResult key={index} {...test} />
                ))}
              </div>
            </div>
          )}

          {activeTab === "vital-signs" && (
            <div>
              <h2 className="text-2xl font-bold text-slate-900 mb-6">
                Current Vital Signs
              </h2>
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {vitalSigns.map((vital, index) => (
                  <div
                    key={index}
                    className="bg-white rounded-lg border border-slate-200 p-6"
                  >
                    <p className="text-sm text-slate-600 mb-2">{vital.label}</p>
                    <p className="text-2xl font-bold text-slate-900 mb-2">
                      {vital.value}
                    </p>
                    <span className="text-xs font-semibold text-slate-600 bg-slate-100 px-3 py-1 rounded-full">
                      {vital.status}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </Layout>
  );
